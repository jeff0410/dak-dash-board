# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다(chmod 600 권장).
DASH_USER=
# 12자 이상
DASH_PASSWORD=

# 서버 주소 — 같은 PC 에서만 볼 땐 127.0.0.1, 리버스 프록시(10번)가 붙을 땐 0.0.0.0
HOST=127.0.0.1
PORT=4545

# HTTPS 서브도메인으로 열 때 1 (쿠키에 Secure 를 붙인다)
COOKIE_SECURE=0
# 리버스 프록시 뒤에서 실제 접속 IP(X-Real-IP)를 믿을 때 1
TRUST_PROXY=0
